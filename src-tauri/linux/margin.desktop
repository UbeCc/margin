[Desktop Entry]
Type=Application
Name={{name}}
GenericName=Markdown Editor
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
TryExec={{exec}}
Icon={{icon}}
Terminal=false
StartupNotify=true
StartupWMClass={{exec}}
Categories={{categories}}
Keywords=markdown;md;editor;notes;writing;
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}

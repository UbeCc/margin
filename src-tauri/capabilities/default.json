{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the editor windows (main + File › New Window ones, `window-N`). File access goes through Margin's own commands (no fs plugin); dialogs and the opener are invoked from Rust, so no plugin permissions are granted to JS.",
  "windows": [
    "main",
    "window-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-read-text-file",
    "allow-write-text-file",
    "allow-stat",
    "allow-list-dir",
    "allow-watch",
    "allow-unwatch",
    "allow-quick-open",
    "allow-store-image",
    "allow-store-image-bytes",
    "allow-open-dialog",
    "allow-save-dialog",
    "allow-export-html",
    "allow-export-pdf",
    "allow-print-window",
    "allow-load-settings",
    "allow-save-settings",
    "allow-list-themes",
    "allow-themes-dir",
    "allow-open-external",
    "allow-set-title",
    "allow-set-document-edited",
    "allow-set-close-guard",
    "allow-confirm-close",
    "allow-take-pending-open-files",
    "allow-allow-asset-dir",
    "allow-set-theme-menu",
    "allow-relocate-images",
    "allow-rename-path",
    "allow-trash-path",
    "allow-create-dir",
    "allow-reveal-path",
    "allow-upload-images",
    "allow-pandoc-detect",
    "allow-pandoc-export",
    "allow-clipboard-write-rich",
    "allow-open-window",
    "allow-read-file-bytes"
  ]
}

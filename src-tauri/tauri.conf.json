{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Margin",
  "mainBinaryName": "margin",
  "version": "0.1.0",
  "identifier": "dev.ubec.margin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Margin",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Transparent",
        "dragDropEnabled": false,
        "tabbingIdentifier": "margin"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' asset: http://asset.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "font-src": "'self' data: asset: http://asset.localhost",
        "media-src": "'self' asset: http://asset.localhost data: blob: https:",
        "object-src": "'none'",
        "frame-src": "'self' https:",
        "base-uri": "'self'"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": [
            "**/.ssh/**",
            "**/.gnupg/**",
            "**/.aws/**",
            "**/.kube/**",
            "**/.docker/**",
            "**/.config/gh/**",
            "**/.config/gcloud/**",
            "**/.azure/**",
            "**/.password-store/**",
            "**/.netrc",
            "**/.git-credentials",
            "**/.npmrc",
            "**/.pypirc",
            "**/Library/Keychains/**",
            "**/Library/Cookies/**",
            "**/.local/share/keyrings/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "WYSIWYG Markdown editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "contentTypes": [
          "net.daringfireball.markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "mkdn",
          "mdwn",
          "mdtxt",
          "mdtext"
        ],
        "contentTypes": [
          "dev.ubec.margin.markdown-alt"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown",
        "exportedType": {
          "identifier": "dev.ubec.margin.markdown-alt",
          "conformsTo": [
            "net.daringfireball.markdown",
            "public.plain-text"
          ]
        }
      },
      {
        "ext": [
          "txt"
        ],
        "contentTypes": [
          "public.plain-text"
        ],
        "name": "Plain Text Document",
        "description": "Plain Text Document",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/margin.desktop",
        "section": "editors"
      },
      "rpm": {
        "desktopTemplate": "linux/margin.desktop"
      }
    }
  }
}
